nextflow_workflow {

    name "Test Subworkflow THIRD_PARTY_DATA"
    script "../main.nf"
    workflow "THIRD_PARTY_DATA"

    tag "subworkflows"
    tag "third_party_data"

    test("virus and plasmid fasta") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        [ id: 'test_virus', type: 'virus', source: 'metagenome', biome: 'human gut' ],
                        file("${projectDir}/assets/test_data/third_party/viruses.fasta.gz", checkIfExists: true)
                    ],
                    [
                        [ id: 'test_plasmid', type: 'plasmid', source: 'metagenome', biome: 'marine sediment' ],
                        file("${projectDir}/assets/test_data/third_party/plasmids.fasta.gz", checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assert workflow.success

            assertAll(
                { assert snapshot(
                    workflow.out.third_party_data
                ).match() }
            )
        }
    }
}