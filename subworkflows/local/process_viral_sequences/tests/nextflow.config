process {
    // seqtk/subseq's stub names its output after the input file only, so the FNA and FAA picks collide
    withName: '.*EXTRACT_CLUSTER_FILES:GREP_.*' { ext.prefix = '_viruses' }
    // seqtk subseq's stub always writes .fa, so the bgzipped reps FNA and FAA share a name
    withName: '.*INDEX_RESULTS:BGZIP_FAA' { ext.prefix = { "${meta.id}_reps_faa" } }
}
