nextflow_process {

    name "Test Process VCLUST"
    script "modules/local/vclust/main.nf"
    process "VCLUST"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [ [id:'MAG1'], file('${moduleDir}/tests/seqs.fasta', checkIfExists: true) ]
                input[1] = 0.95
                input[2] = 0.85
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
