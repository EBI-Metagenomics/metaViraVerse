nextflow_process {

    name "Test Process SANKEY_PLOT"
    script "modules/local/sankey_plot/main.nf"
    process "SANKEY_PLOT"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [ [id:'test'], file('${moduleDir}/tests/viral_sequences_krona.tsv', checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
