nextflow_process {

    name "Test Process EXTRACT_REPS_STATS"
    script "modules/local/extract_reps_stats/main.nf"
    process "EXTRACT_REPS_STATS"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = [ [id:'test'], file('${moduleDir}/tests/viral_sequences_clusters.tsv', checkIfExists: true) ]
                input[1] = [ file('${moduleDir}/tests/combined.gff', checkIfExists: true), file('${moduleDir}/tests/combined.map', checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
            assert path(process.out.reps_krona_tsv[0][1]).readLines().size() == 7
            assert path(process.out.reps_stats_tsv[0][1]).readLines().size() == 32
        }

    }

}
