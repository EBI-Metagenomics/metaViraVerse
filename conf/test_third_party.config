/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run EBI-Metagenomics/metaviraverse -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    errorStrategy = 'retry'
    maxRetries = 1
    resourceLimits = [
        cpus: 2,
        memory: '12.GB',
        time: '1.h'
    ]

    withName: '.*FALINT.*' {
        memory = '4.GB'
        cpus   = 2
    }
}

params {
    config_profile_name        = 'Test third party input'
    config_profile_description = 'Test minimal functionality on third party input'

    third_party_input                     = "${projectDir}/assets/samplesheet_third_party.csv"
    outdir                                = "third_party_test"

    skip_rrna_detection                   = true
    skip_checkv                           = true
    skip_vitap                            = true
    skip_genomad                          = true
    skip_viphogs                          = true
    skip_amrfinderplus_for_viruses        = true
    skip_deeparg_for_viruses              = true
    skip_rgi_for_viruses                  = true
    skip_amrfinderplus_for_plasmids       = true
    skip_deeparg_for_plasmids             = true
    skip_rgi_for_plasmids                 = true
    skip_iphop                            = true
    skip_phammseqs                        = true
    skip_mmseqs                           = true
    predict_host_from_custom_spacers      = false
}
