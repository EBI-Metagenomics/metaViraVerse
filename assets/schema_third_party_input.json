{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/EBI-Metagenomics/metaviraverse/main/assets/schema_third_party_input.json",
    "title": "EBI-Metagenomics/metaviraverse - third-party input schema",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "ID must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "fasta": {
                "type": "string",
                "format": "file-path",
                "description": "Path to FASTA file with nucleotide sequences"
            },
            "type": {
                "type": "string",
                "enum": ["virus", "plasmid", "prophage"],
                "description": "Sequence type: virus | plasmid | prophage",
                "meta": ["type"]
            },
            "source": {
                "type": "string",
                "enum": ["genome", "metagenome"],
                "description": "Use 'genome' for MAG or isolate; use 'metagenome' for assembly",
                "meta": ["source"]
            },
            "biome": {
                "type": "string",
                "description": "(Optional) Environmental biome, max 2 words (e.g. marine sediment or human gut)",
                "meta": ["biome"]
            },
            "study_accession": {
                "type": "string",
                "description": "(Optional) INSDC study primary or secondary accession related to input data",
                "meta": ["study_accession"]
            },
            "sample_accession": {
                "type": "string",
                "description": "(Optional) INSDC sample accession related to input data",
                "meta": ["sample_accession"]
            }
        },
        "required": ["id", "fasta", "type"]
    }
}
